{
  "name": "aztec-shielded-portal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "yarn@4.5.2",
  "bin": {
    "portal": "cli/portal.ts"
  },
  "description": "PoC bridge: Tornado-origin ETH on L1 -> private tornadoETH notes on Aztec.",
  "scripts": {
    "compile:aztec": "cd contracts/aztec && aztec compile",
    "codegen": "aztec codegen contracts/aztec/target -o src/generated",
    "build:l1": "aztec-forge build --root contracts/l1",
    "build": "yarn compile:aztec && yarn codegen && yarn build:l1 && tsc --noEmit",
    "prover:install": "npm --prefix prover ci && node prover/fetch-assets.cjs",
    "typecheck": "tsc --noEmit",
    "test:l1": "aztec-forge test --root contracts/l1",
    "test:l1:fork": "aztec-forge test --root contracts/l1 --match-path 'test/fork/*.t.sol' -vv",
    "test:sdk": "node --import tsx --test test/sdk-config.test.ts test/real-tornado.test.ts test/tornado-history.test.ts",
    "test:aztec-unit": "cd contracts/aztec && aztec test",
    "test:aztec": "node --import tsx --test --test-concurrency=1 test/aztec.test.ts test/forwarder-recovery.test.ts",
    "test:e2e": "node --import tsx --test test/e2e.test.ts",
    "test:fork": "node --import tsx --test test/fork/real-tornado.fork.test.ts",
    "rehearsal:real-tornado": "tsx scripts/real-tornado-rehearsal.ts",
    "rehearsal:sepolia": "tsx scripts/sepolia-rehearsal.ts",
    "deploy:l1": "tsx scripts/deploy-l1.ts",
    "deploy:aztec": "tsx scripts/deploy-aztec.ts",
    "demo": "tsx scripts/demo-flow.ts",
    "portal": "tsx cli/portal.ts",
    "clean": "rm -rf contracts/aztec/target contracts/l1/out contracts/l1/cache src/generated .tsbuildinfo"
  },
  "dependencies": {
    "@aztec-foundation/l1-artifacts": "6.0.0",
    "@aztec-labs/accounts": "6.0.0",
    "@aztec-labs/aztec.js": "6.0.0",
    "@aztec-labs/constants": "6.0.0",
    "@aztec-labs/ethereum": "6.0.0",
    "@aztec-labs/foundation": "6.0.0",
    "@aztec-labs/stdlib": "6.0.0",
    "@aztec-labs/wallets": "6.0.0",
    "viem": "2.57.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "~5.7.3"
  },
  "engines": {
    "node": ">=22"
  }
}
