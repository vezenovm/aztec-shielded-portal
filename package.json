{
  "name": "aztec-shielded-portal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "yarn@4.5.2",
  "bin": {
    "portal": "cli/portal.ts"
  },
  "description": "PoC bridge: Tornado-origin ETH on L1 -> private tornadoETH notes on Aztec.",
  "scripts": {
    "compile:aztec": "cd contracts/aztec && aztec compile",
    "codegen": "aztec codegen contracts/aztec/target -o src/generated",
    "build:l1": "forge build --root contracts/l1",
    "build": "yarn compile:aztec && yarn codegen && yarn build:l1 && tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test:l1": "forge test --root contracts/l1",
    "test:l1:fork": "forge test --root contracts/l1 --match-path 'test/fork/*.t.sol' -vv",
    "test:sdk": "node --import tsx --test test/sdk-config.test.ts test/real-tornado.test.ts",
    "test:aztec-unit": "cd contracts/aztec && aztec test",
    "test:aztec": "node --import tsx --test test/aztec.test.ts",
    "test:e2e": "node --import tsx --test test/e2e.test.ts",
    "test:fork": "node --import tsx --test test/fork/real-tornado.fork.test.ts",
    "rehearsal:real-tornado": "tsx scripts/real-tornado-rehearsal.ts",
    "deploy:l1": "tsx scripts/deploy-l1.ts",
    "deploy:aztec": "tsx scripts/deploy-aztec.ts",
    "demo": "tsx scripts/demo-flow.ts",
    "portal": "tsx cli/portal.ts",
    "clean": "rm -rf contracts/aztec/target contracts/l1/out contracts/l1/cache src/generated .tsbuildinfo"
  },
  "dependencies": {
    "@aztec/accounts": "5.0.0-rc.1",
    "@aztec/aztec.js": "5.0.0-rc.1",
    "@aztec/constants": "5.0.0-rc.1",
    "@aztec/ethereum": "5.0.0-rc.1",
    "@aztec/foundation": "5.0.0-rc.1",
    "@aztec/l1-artifacts": "5.0.0-rc.1",
    "@aztec/stdlib": "5.0.0-rc.1",
    "@aztec/wallets": "5.0.0-rc.1",
    "viem": "npm:@aztec/viem@2.38.2"
  },
  "optionalDependencies": {
    "circomlibjs": "^0.1.7",
    "fixed-merkle-tree": "^0.7.3",
    "snarkjs": "^0.7.4"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "~5.7.3"
  },
  "engines": {
    "node": ">=22"
  }
}
